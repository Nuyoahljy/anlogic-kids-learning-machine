# The immutable pixels/snapshots/native caches remain local and SHA-bound.
*
!.gitignore
!.gitattributes
!README.md
!software-v1.json
!protected-baselines.json
!runs/
!runs/*/
!runs/*/run-manifest.json
!runs/*/run-start.json
!runs/*/summary.json
!runs/*/stdout.log
!runs/*/stderr.log
!runs/*/transcript.log
!runs/*/scene-results.csv
!runs/*/observations.csv
!model-v*/
!model-v*/report.json
!model-v*/synthetic-samples.png
!fixtures-v1/
!fixtures-v1/manifest.json
!fixtures-v1/*-cases.txt
!new-system-v1/
!new-system-v1/manifest.json
!new-system-v1/cases.txt
!new-system-v1/truth-cases.txt
!retained-system-v1/
!retained-system-v1/manifest.json
!retained-system-v1/cases.txt
!retained-system-v1/truth-cases.txt
!render-fixtures/
!render-fixtures/manifest.json
